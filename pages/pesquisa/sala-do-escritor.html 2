<!-- ===== INÍCIO: ESTÚDIO DE CRIAÇÃO  =====-->
    
<style>
#esPainel .es-passos{display:flex;gap:8px;flex-wrap:wrap}
.es-box[hidden]{display:none!important}
#esPainel .es-passos .at-btn.on{background:var(--brass);border-color:var(--brass);color:#fffdf6}
.es-box{border:1px solid var(--paper-line);border-radius:8px;background:var(--paper-card);color:var(--ink);padding:18px;display:flex;flex-direction:column;gap:14px}
.es-box h3{margin:0;font:600 20px Georgia,"Times New Roman",serif}
.es-box p.es-nota{margin:0;color:var(--ink-soft);font:13.5px/1.5 "Segoe UI",Arial,sans-serif}
.es-box .at-sel,.es-box .at-in{background:#fffdf6;border-color:var(--paper-line);color:var(--ink)}
.es-box .at-btn{background:#fffdf6;border-color:var(--paper-line);color:var(--ink)}
.es-box .at-btn:hover:not(:disabled){background:var(--brass-wash);border-color:var(--brass)}
.es-box .at-btn.gold{background:var(--brass);border-color:var(--brass);color:#fffdf6}
.es-cartoes{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px}
.es-cartao{text-align:left;padding:12px 13px;border:1px solid var(--paper-line);border-radius:6px;background:#fffdf6;color:var(--ink);cursor:pointer;font:16px/1.3 Georgia,"Times New Roman",serif}
.es-cartao:hover{border-color:var(--brass)}
.es-cartao[aria-pressed="true"]{background:var(--brass);border-color:var(--brass);color:#fffdf6}
.es-campo{display:flex;flex-direction:column;gap:5px;font:700 12px "Segoe UI",Arial,sans-serif;color:var(--ink-soft)}
.es-texto{width:100%;min-height:300px;resize:vertical;box-sizing:border-box;padding:14px;border:1px solid var(--paper-line);border-radius:8px;background:#fff;color:var(--ink);font:18px/1.8 Georgia,"Times New Roman",serif}
.es-texto:focus{outline:2px solid var(--brass)}
.es-msg{min-height:1.4em;font:600 13.5px "Segoe UI",Arial,sans-serif;color:var(--brass-deep)}
.es-msg.erro{color:#a14747}
.es-fotos{display:flex;gap:8px;flex-wrap:wrap}
.es-foto{position:relative;width:90px;height:90px;border-radius:6px;overflow:hidden;border:1px solid var(--paper-line)}
.es-foto img{width:100%;height:100%;object-fit:cover}
.es-foto button{position:absolute;top:2px;right:2px;width:22px;height:22px;border:0;border-radius:50%;background:rgba(0,0,0,.65);color:#fff;cursor:pointer}
.es-previa{display:grid;grid-template-columns:minmax(260px,380px) 1fr;gap:18px;align-items:start}
@media(max-width:800px){.es-previa{grid-template-columns:1fr}}
.es-tela{position:relative;width:100%;max-width:380px;background:#1b1b1b center/cover no-repeat;border-radius:8px;overflow:hidden;display:flex;align-items:flex-end;justify-content:center;transition:background-image .6s}
.es-tela.f916{aspect-ratio:9/16}.es-tela.f11{aspect-ratio:1/1}.es-tela.f169{aspect-ratio:16/9;max-width:100%}
.es-tela::before{content:"";position:absolute;inset:0;background:linear-gradient(transparent 45%,rgba(0,0,0,.65))}
.es-legenda{position:relative;padding:18px;text-align:center;color:#fff;font:600 17px/1.5 Georgia,serif;text-shadow:0 1px 6px rgba(0,0,0,.8)}
.es-dest{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px}
.es-dest label{display:flex;gap:8px;align-items:flex-start;padding:10px 12px;border:1px solid var(--paper-line);border-radius:6px;background:#fffdf6;cursor:pointer;font:14px/1.4 "Segoe UI",Arial,sans-serif}
.es-dest small{display:block;color:var(--ink-soft);font-size:12px}
.es-vers{display:flex;flex-direction:column;gap:6px}
.es-vers div{display:flex;gap:8px;align-items:center;padding:8px 10px;border:1px solid var(--paper-line);border-radius:6px;background:#fffdf6;font:14px Georgia,serif}
.es-vers div span{flex:1}
