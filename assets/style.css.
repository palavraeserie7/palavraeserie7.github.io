body{
    margin:0;
    padding:0;
    background:#0B1628;
    color:#F8F4EC;
    font-family:Arial, sans-serif;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
    padding:20px;
}

.header{
    background:#111827;
    padding:20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.books-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-top:30px;
}

.book-card{
    background:#111827;
    border:1px solid #1f2937;
    border-radius:15px;
    padding:20px;
}

.login-card{
    max-width:400px;
    margin:80px auto;
}

.book-card input{
    width:100%;
    padding:12px;
    margin-bottom:15px;
    border:none;
    border-radius:8px;
}

.tag{
    display:inline-block;
    padding:5px 10px;
    border-radius:20px;
    font-size:12px;
    margin-bottom:10px;
}

.free-tag{
    background:#00aa55;
}

.pro-tag{
    background:#C9A84C;
    color:#000;
}

.btn-liberado,
.btn-bloqueado,
.btn-sair{
    display:inline-block;
    border:none;
    padding:10px 15px;
    border-radius:8px;
    cursor:pointer;
    text-decoration:none;
    font-weight:bold;
}

.btn-liberado{
    background:#00cc66;
    color:#fff;
}

.btn-bloqueado{
    background:#444;
    color:#fff;
}

.btn-sair{
    background:#ff4444;
    color:#fff;
}

.dashboard-box{
    background:#111827;
    padding:20px;
    border-left:5px solid #00cc66;
    border-radius:12px;
}
